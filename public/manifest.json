{
  "manifest_version": 3,
  "name": "FarsiFlow for Coddy",
  "version": "0.1.0",
  "description": "Translate Coddy learning interfaces into Persian while keeping every code surface untouched.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://coddy.tech/*", "https://*.coddy.tech/*", "https://api.openai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "action": { "default_title": "FarsiFlow", "default_popup": "popup.html" },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://coddy.tech/*", "https://*.coddy.tech/*"],
    "js": ["assets/content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
